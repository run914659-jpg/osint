# Telegram bot token from @BotFather (REQUIRED)
BOT_TOKEN=

# Comma-separated Telegram user IDs with admin access (R1)
ADMIN_IDS=123456789,987654321

# polling | webhook  (default: polling)
RUN_MODE=polling

# Webhook configuration (used when RUN_MODE=webhook)
WEBHOOK_PATH=/webhook
# Secret token validated on the X-Telegram-Bot-Api-Secret-Token header.
# CHANGE THIS in production ("change-me" is only the local default).
WEBHOOK_SECRET=change-me
# Public origin of the service, e.g. https://osint-bot.onrender.com
PUBLIC_BASE_URL=https://example.onrender.com

# SQLite database file (Render persistent disk: /var/data/bot.db)
DB_PATH=./bot.db

# HTTP port for the webhook /health server (Render sets PORT itself)
PORT=8000

# Optional — only ADDS data to phone lookups when present (R7)
NUMVERIFY_API_KEY=

# Optional — higher lookup.binlist.net rate limits for the BIN tool
BINLIST_API_KEY=

# Optional — set to 1 to enable the heavy maigret extra for username lookups
USE_MAIGRET=0
